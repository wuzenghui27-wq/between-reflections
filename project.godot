; 倒影之间 · Between Reflections — Godot 4 工程（与网页版、Unity 版共用 shared/ 里的数据与像素图）
; 像素完美设置：画面内部 320×180，只按整数倍放大，余下补黑边；最近邻过滤，不生成 mipmap，不压缩；2D 变换与顶点对齐到像素；字体不抗锯齿。

config_version=5

[application]

config/name="倒影之间 Between Reflections"
config/description="按一下，天地在白昼与长夜之间翻转。Game Off 2026 · SHIFT"
run/main_scene="res://godot/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.047, 0.07, 0.15, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[importer_defaults]

texture={
"compress/mode": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": false,
"process/premult_alpha": false,
"detect_3d/compress_to": 0
}
font_data_dynamic={
"antialiasing": 0,
"generate_mipmaps": false,
"hinting": 0,
"subpixel_positioning": 0,
"multichannel_signed_distance_field": false,
"force_autohinter": false
}

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
